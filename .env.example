# Jeevan Productions — environment variables
#
# Copy this file to `.env.local` (git-ignored, see .gitignore) and fill in
# real values. Never commit actual secrets.

# --- Cloudflare Turnstile (bot protection on the careers + contact forms) ---
# Server-side secret used to verify a submitted Turnstile token against
# https://challenges.cloudflare.com/turnstile/v0/siteverify. See
# src/lib/form-security.ts (`verifyTurnstile`).
#
# If this is NOT set:
#   - in production, form submissions are rejected (fail closed).
#   - outside production (dev/test), submissions are allowed through so the
#     forms stay testable locally without Cloudflare credentials.
TURNSTILE_SECRET_KEY=

# Public site key for the Turnstile widget, rendered client-side in
# src/components/forms/Turnstile.tsx. If unset, the widget silently doesn't
# render (dev mode) and the form still works.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Application/enquiry delivery ---
# No storage or CRM provider is wired up in this codebase, and no storage
# credentials are committed. Each form's single hand-off function
# (`deliverApplication()` in src/app/careers/actions.ts,
# `deliverEnquiry()` in src/app/contact/actions.ts) POSTs the validated
# submission (as multipart form data: a `payload` JSON field, plus a `file`
# field for the careers resume) to the corresponding webhook URL below.
#
# Point these at whatever you use to receive submissions — a Zapier/Make
# webhook, an ATS or CRM's inbound endpoint, a small serverless function that
# emails the team and saves the resume to S3, etc. If a URL is left unset,
# the corresponding action throws a descriptive "not configured" error
# instead of silently discarding a real submission.
APPLICATION_WEBHOOK_URL=
ENQUIRY_WEBHOOK_URL=

# --- CMS database (Postgres) -------------------------------------------------
# Production: a Postgres connection string — Neon (via the Vercel Marketplace
# integration, which sets DATABASE_URL automatically), Vercel Postgres,
# Supabase, or any Postgres 14+. Use the POOLED connection string on Vercel.
# `npm run build` applies pending migrations (./drizzle) before building.
#
# Local dev: leave it EMPTY and `npm run dev` uses an embedded PGlite database
# in .data/pglite (git-ignored), migrated automatically. Nothing to install.
DATABASE_URL=

# --- First admin account -----------------------------------------------------
# Either run `npm run admin:create` against the target database, or set these
# two and sign in at /admin/login with exactly these credentials: while the
# users table is empty, that first login creates the admin. Remove them once
# you're in — they do nothing after the first user exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Media uploads -----------------------------------------------------------
# Vercel Blob read/write token (Vercel dashboard → Storage → Blob → connect to
# project sets this automatically). Required in production — Vercel's
# filesystem is read-only. Unset in dev = uploads go to public/uploads/.
BLOB_READ_WRITE_TOKEN=
